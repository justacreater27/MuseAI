# Backend AI providers (set at runtime; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Frontend API base URL. Leave blank for local Vite proxy; set to deployed API origin in production.
VITE_API_URL=

# Public Firebase web configuration for project museai-ec4d3
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=museai-ec4d3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=museai-ec4d3
VITE_FIREBASE_STORAGE_BUCKET=museai-ec4d3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional comma-separated browser origins allowed by the backend
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
